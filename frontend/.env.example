# MapLibre style URL. Default: OpenFreeMap "liberty" (free, no API key). If it fails to load, the app
# falls back to a raster OpenStreetMap style.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# API base path/URL. Default "/api" (same-origin; the Vite dev server proxies it to the backend so cookies work).
VITE_API_BASE=/api
# Dev only: where the Vite proxy forwards /api
VITE_DEV_PROXY_TARGET=http://localhost:8000
