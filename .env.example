# Copy to .env (never commit .env). All variables are optional except the database URL in production.
FOODACCESS_DATABASE_URL=postgresql+psycopg://localhost:5433/foodaccess
FOODACCESS_ENVIRONMENT=development          # development | test | production
FOODACCESS_SHOW_SYNTHETIC=false             # true only for local demos; refused in production publishing
FOODACCESS_CORS_ORIGINS=["http://localhost:5173"]
FOODACCESS_COOKIE_SECURE=false              # true behind HTTPS
FOODACCESS_SESSION_DAYS=14
FOODACCESS_LOGIN_ATTEMPTS_PER_15MIN=10
FOODACCESS_VERIFICATION_FRESH_DAYS=90
FOODACCESS_GEOCODERS=["zip","census","nominatim"]
FOODACCESS_NOMINATIM_URL=https://nominatim.openstreetmap.org   # self-host for production traffic
FOODACCESS_HTTP_USER_AGENT=NoVAFoodAccess/0.1 (+contact: your-email@example.org)
FOODACCESS_TRANSLATION_PROVIDER=none        # none | libretranslate | argos
FOODACCESS_LIBRETRANSLATE_URL=http://localhost:5000
FOODACCESS_MAX_SEARCH_RADIUS_KM=80
# Used only by `foodaccess create-admin` (otherwise it prompts)
# FOODACCESS_ADMIN_PASSWORD=
# Frontend (Vite)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Database password for docker-compose
POSTGRES_PASSWORD=change-me
